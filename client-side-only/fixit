#!/usr/bin/env bash
#
set -euo pipefail
shopt -s nullglob

path1="${1:?usage: $0 /path/to/dir1 /path/to/dir2 [--no-dry-run]}"
path2="${2:?usage: $0 /path/to/dir1 /path/to/dir2 [--no-dry-run]}"

dry_run=1
[[ "${3:-}" == "--no-dry-run" ]] && dry_run=0

# Return unique prefixes (before first '-') for regular files in a dir
prefixes() {
  local d="$1"
  # 'find' avoids ls/whitespace issues; cut keeps only prefix; sort -u uniqs
  find "$d" -maxdepth 1 -type f -printf '%f\n' | cut -d- -f1 | sort -u
}

# Common prefixes between path1 and path2
mapfile -t common < <(
  comm -12 <(prefixes "$path1") <(prefixes "$path2")
)

if ((${#common[@]}==0)); then
  echo "No shared prefixes; nothing to do."
  exit 0
fi

echo "Found ${#common[@]} shared prefix(es)."
((dry_run)) && echo "[DRY RUN] Use --no-dry-run to actually delete."

for prefix in "${common[@]}"; do
  # All files in path1 that start with the prefix + '-'
  matches=( "$path1"/"$prefix"-* )

  case "${#matches[@]}" in
    0)
      # Nothing to delete in path1 for this prefix
      ;;
    1)
      if ((dry_run)); then
        echo "[DRY RUN] would delete: ${matches[0]}"
      else
        rm -v -- "${matches[0]}"
      fi
      ;;
    *)
      echo "SKIP: multiple files in '$path1' for prefix '$prefix':"
      printf '  %s\n' "${matches[@]}"
      ;;
  esac
done
